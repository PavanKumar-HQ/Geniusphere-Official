# ====================================================================
# GENIUSPHERE SELF-HOSTED PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env.production and customize with secure generated secrets
# ====================================================================

# 1. Platform Application
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
APP_DOMAIN=learn.geniusphere.tech
APP_URL=https://learn.geniusphere.tech

# 2. Cryptographic Secrets (Minimum 32 random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_cryptographically_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# 3. PostgreSQL Database
POSTGRES_DB=geniusphere_prod
POSTGRES_USER=geniusphere_admin
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://geniusphere_admin:replace_with_strong_database_password@db:5432/geniusphere_prod
DATABASE_SSL=false
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50

# 4. Hybrid AI Gateway Configuration
AI_ROUTING_POLICY=prefer_local_fallback_hosted
# Local Inference (Ollama container)
AI_LOCAL_ENDPOINT=http://ollama:11434
AI_LOCAL_MODEL=llama3:8b
# Hosted Inference (Google Gemini)
AI_HOSTED_PROVIDER=gemini
GEMINI_API_KEY=replace_with_production_gemini_api_key
AI_HOSTED_MODEL=gemini-1.5-flash
# Concurrency & Safeguards
AI_MAX_CONCURRENCY=16
AI_TIMEOUT_MS=15000

# 5. Web Push Notifications (Optional VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@geniusphere.tech

# 6. Operational Backups
BACKUP_DIR=/backups
DB_CONTAINER=geniusphere_db
