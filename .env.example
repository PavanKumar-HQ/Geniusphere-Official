# Geniusphere Environment Template
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Authoritative PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/geniusphere_prod

# Cryptographic Token Authentication
JWT_SECRET=replace_with_a_secure_random_hex_or_passphrase_32_chars_min

# Web Push VAPID Protocol Keys
VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# AI Service Configuration (Provider-Neutral)
# Supported AI_PROVIDER values: none (unconfigured), gemini
AI_PROVIDER=none
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=15000
AI_RATE_LIMIT_MAX_PER_MIN=20

